# Copier en .env et renseigner avec les valeurs de VOTRE projet Supabase.
# NE JAMAIS committer .env ni la clé service_role.

# Clés PUBLIQUES, exposées côté client (protégées par la RLS) :
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_ANON

# Clé SECRÈTE service_role : UNIQUEMENT côté serveur (Edge Functions).
# À définir dans les secrets Supabase, jamais dans le bundle client.
# SUPABASE_SERVICE_ROLE_KEY=...
